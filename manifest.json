{
  "manifest_version": 3,
  "name": "My AdBlock",
  "version": "1.1.0",
  "description": "A personal ad blocker for websites, YouTube, Twitch and Kick.",
  "minimum_chrome_version": "111",
  "permissions": ["declarativeNetRequest", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "My AdBlock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
